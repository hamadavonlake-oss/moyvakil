generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  professional
  editor
  admin
  super_admin
}

enum DocumentStatus {
  current
  amended
  repealed
  draft
  future_effective
}

enum SectionType {
  chapter
  article
  paragraph
  subparagraph
  section
  definition
  tbl
  annex
  footnote
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum MessageRole {
  user
  assistant
  system
}

enum AuditAction {
  user_register
  user_login
  source_create
  source_update
  document_create
  document_update
  document_delete
  chat_message
  answer_generate
  review_request
  consent_grant
  consent_revoke
  admin_action
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  password        String
  name            String
  role            UserRole         @default(user)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  profile         Profile?
  conversations   Conversation[]
  auditEvents     AuditEvent[]
  consents        Consent[]
  requestsMade    ReviewRequest[]  @relation("Requester")
  requestsHandled ReviewRequest[]  @relation("Professional")
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  bio       String? @db.Text
  avatarUrl String?
  locale    String? @default("uz")
}

model Country {
  id            String          @id @default(cuid())
  code          String          @unique
  nameUz        String
  nameRu        String
  nameEn        String
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  jurisdictions Jurisdiction[]
  legalSources  LegalSource[]
  documents     LegalDocument[]
  sections      LegalSection[]
}

model Jurisdiction {
  id        String        @id @default(cuid())
  countryId String
  country   Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  code      String
  name      String
  level     String
  parentId  String?
  parent    Jurisdiction? @relation("JurisdictionTree", fields: [parentId], references: [id])
  children  Jurisdiction[] @relation("JurisdictionTree")
  isActive  Boolean       @default(true)
  documents LegalDocument[]
  sections  LegalSection[]
  @@unique([countryId, code])
}

model Language {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  direction String   @default("ltr")
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LegalSource {
  id                   String   @id @default(cuid())
  authorityName        String
  authorityType        String
  countryCode          String
  country              Country  @relation(fields: [countryCode], references: [code])
  officialUrl          String
  retrievedAt          DateTime @default(now())
  publishedAt          DateTime?
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  status               String   @default("active")
  language             String   @default("uz")
  title                String
  documentNumber       String?
  documentType         String
  checksum             String?
  licenseOrAccessNotes String?
  parserVersion        String?
  contentHash          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  documents            LegalDocument[]
  @@index([countryCode, documentType])
  @@index([status])
}

model LegalDocument {
  id              String             @id @default(cuid())
  sourceId        String
  source          LegalSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  countryId       String
  country         Country            @relation(fields: [countryId], references: [id], onDelete: Cascade)
  jurisdictionId  String?
  jurisdiction    Jurisdiction?      @relation(fields: [jurisdictionId], references: [id])
  title           String
  documentType    String
  status          DocumentStatus     @default(current)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  languageCode    String             @default("uz")
  contentHash     String
  lastIndexedAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  versions        LegalVersion[]
  sections        LegalSection[]
  outgoingRefs    LegalRelationship[] @relation("FromDoc")
  incomingRefs    LegalRelationship[] @relation("ToDoc")
  @@index([countryId, documentType])
  @@index([status])
  @@index([sourceId])
}

model LegalVersion {
  id            String         @id @default(cuid())
  documentId    String
  document      LegalDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  status        DocumentStatus @default(current)
  contentHash   String
  sourceUrl     String?
  createdAt     DateTime       @default(now())
  sections      LegalSection[]
  @@unique([documentId, versionNumber])
}

model LegalSection {
  id                String            @id @default(cuid())
  documentId        String
  document          LegalDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId         String
  version           LegalVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  parentSectionId   String?
  parentSection     LegalSection?     @relation("SectionTree", fields: [parentSectionId], references: [id])
  childSections     LegalSection[]    @relation("SectionTree")
  sectionType       SectionType
  sectionLabel      String?
  ordinal           Int
  languageCode      String
  countryCode       String
  country           Country           @relation(fields: [countryCode], references: [code])
  jurisdictionId    String?
  jurisdiction      Jurisdiction?     @relation(fields: [jurisdictionId], references: [id])
  textOriginal      String            @db.Text
  textNormalized    String            @db.Text
  sourceUrl         String
  sourceStartOffset Int?
  sourceEndOffset   Int?
  status            DocumentStatus    @default(current)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  contentHash       String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  embeddings        Embedding[]
  outgoingRefs      LegalRelationship[] @relation("FromSection")
  incomingRefs      LegalRelationship[] @relation("ToSection")
  @@index([documentId, sectionType])
  @@index([versionId])
  @@index([countryCode, languageCode])
  @@index([status])
}

model LegalRelationship {
  id              String        @id @default(cuid())
  fromDocumentId  String
  fromDocument    LegalDocument @relation("FromDoc", fields: [fromDocumentId], references: [id], onDelete: Cascade)
  toDocumentId    String
  toDocument      LegalDocument @relation("ToDoc", fields: [toDocumentId], references: [id], onDelete: Cascade)
  fromSectionId   String?
  fromSection     LegalSection? @relation("FromSection", fields: [fromSectionId], references: [id], onDelete: Cascade)
  toSectionId     String?
  toSection       LegalSection? @relation("ToSection", fields: [toSectionId], references: [id], onDelete: Cascade)
  relationshipType String
  label           String?
  @@unique([fromDocumentId, toDocumentId, relationshipType])
}

model Embedding {
  id          String      @id @default(cuid())
  sectionId   String
  section     LegalSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  embedding   Unsupported("vector(1536)")
  modelName   String      @default("text-embedding-3-small")
  dimensions  Int         @default(1536)
  createdAt   DateTime    @default(now())
  @@index([sectionId])
}

model Conversation {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryCode String
  language    String      @default("uz")
  title       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  messages    Message[]
  @@index([userId])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            MessageRole
  content         String       @db.Text
  metadata        Json?
  createdAt       DateTime     @default(now())
  answer          Answer?
  @@index([conversationId])
}

model Answer {
  id               String    @id @default(cuid())
  messageId        String    @unique
  message          Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  jurisdiction     String
  language         String
  shortAnswer      String    @db.Text
  answer           String    @db.Text
  assumptions      String[]
  missingFacts     String[]
  nextSteps        String[]
  riskLevel        RiskLevel @default(low)
  needsHumanReview Boolean   @default(false)
  confidence       Float     @default(0)
  disclaimer       String    @db.Text
  promptVersion    String?
  modelVersion     String?
  latencyMs        Int?
  createdAt        DateTime  @default(now())
  citations        Citation[]
  @@index([messageId])
}

model Citation {
  id            String    @id @default(cuid())
  answerId      String
  answer        Answer    @relation(fields: [answerId], references: [id], onDelete: Cascade)
  sourceId      String?
  sectionId     String?
  title         String
  article       String?
  url           String?
  effectiveDate DateTime?
  status        String?
  quotedText    String?   @db.Text
  createdAt     DateTime  @default(now())
  @@index([answerId])
}

model Feedback {
  id        String   @id @default(cuid())
  answerId  String
  userId    String?
  rating    String
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  @@index([answerId])
}

model ReviewRequest {
  id             String    @id @default(cuid())
  requesterId    String
  requester      User      @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   User?     @relation("Professional", fields: [professionalId], references: [id])
  matterSummary  String    @db.Text
  urgency        String    @default("routine")
  budget         String?
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@index([status])
}

model Consent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String
  granted   Boolean
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  @@index([userId])
}

model AuditEvent {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model PromptVersion {
  id           String   @id @default(cuid())
  name         String
  version      Int
  systemPrompt String   @db.Text
  model        String   @default("gpt-4o-mini")
  temperature  Float    @default(0.3)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  @@unique([name, version])
}

model EvaluationCase {
  id                String   @id @default(cuid())
  countryCode       String
  language          String
  question          String   @db.Text
  expectedAnswer    String   @db.Text
  expectedCitations Json?
  riskLevel         RiskLevel @default(low)
  topic             String
  difficulty        String   @default("medium")
  createdAt         DateTime @default(now())
  runs              EvaluationRun[]
}

model EvaluationRun {
  id           String   @id @default(cuid())
  caseId       String
  case         EvaluationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  modelVersion String
  actualAnswer String   @db.Text
  score        Float?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  @@index([caseId])
}
